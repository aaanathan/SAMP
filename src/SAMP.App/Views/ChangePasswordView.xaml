<UserControl x:Class="SAMP.App.Views.ChangePasswordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:SAMP.App">
    <StackPanel Width="380" Margin="24" HorizontalAlignment="Left">
        <TextBlock Style="{StaticResource Heading}" Text="Change password"/>
        <TextBlock Visibility="{Binding IsForced, Converter={x:Static app:BoolToVisibility.Instance}}" TextWrapping="Wrap"
                   Style="{StaticResource Label}" Margin="0,0,0,12"
                   Text="You must choose a new password before you can continue. You will be asked to sign in again afterwards."/>
        <TextBlock Text="Current password" Style="{StaticResource Label}"/>
        <PasswordBox app:PasswordBoxHelper.BoundPassword="{Binding Current, Mode=TwoWay}"/>
        <TextBlock Text="New password (min. 12 characters, 3 character types)" Style="{StaticResource Label}"/>
        <PasswordBox app:PasswordBoxHelper.BoundPassword="{Binding New, Mode=TwoWay}"/>
        <TextBlock Text="Confirm new password" Style="{StaticResource Label}"/>
        <PasswordBox app:PasswordBoxHelper.BoundPassword="{Binding Confirm, Mode=TwoWay}"/>
        <TextBlock Style="{StaticResource ErrorText}" Text="{Binding ErrorMessage}"/>
        <Button Content="Change password" Command="{Binding ChangeCommand}" IsDefault="True" HorizontalAlignment="Left"/>
    </StackPanel>
</UserControl>
