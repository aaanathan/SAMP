<UserControl x:Class="SAMP.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:SAMP.App">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="520" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource Heading}" Text="Settings"/>
            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding ErrorMessage}"/>
            <TextBlock Style="{StaticResource InfoText}" Text="{Binding InfoMessage}"/>

            <TextBlock FontWeight="SemiBold" Text="Auto-block duration"/>
            <TextBlock Style="{StaticResource Label}" TextWrapping="Wrap" Text="Applies to new unblock windows. A running window is never extended."/>
            <StackPanel Orientation="Horizontal">
                <TextBox Width="100" Text="{Binding DurationMinutes, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text=" minutes" Margin="4,0,12,0"/>
                <Button Content="Save" Command="{Binding SaveDurationCommand}"/>
            </StackPanel>
            <CheckBox Content="Also shorten the currently running window if the new value is lower" IsChecked="{Binding ApplyToCurrent}" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Maximum allowed:" Margin="0,0,8,0"/>
                <TextBox Width="100" Text="{Binding MaxMinutes, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Content="Save maximum" Command="{Binding SaveMaxCommand}" Margin="12,4,8,4"/>
            </StackPanel>

            <Separator Margin="0,16"/>
            <TextBlock FontWeight="SemiBold" Text="External log location"/>
            <TextBlock Style="{StaticResource Label}" TextWrapping="Wrap"
                       Text="Closed daily log files are copied here (still encrypted). Leave empty to disable. Logs are kept for 30 days."/>
            <TextBox Text="{Binding ExternalLogPath, UpdateSourceTrigger=PropertyChanged}"/>
            <Button Content="Save location" Command="{Binding SaveExternalPathCommand}" HorizontalAlignment="Left"/>

            <Separator Margin="0,16"/>
            <TextBlock FontWeight="SemiBold" Text="Uninstall password"/>
            <TextBlock Style="{StaticResource Label}" TextWrapping="Wrap"
                       Text="Enter the current uninstall password, or – if it was forgotten – your own login password."/>
            <TextBlock Text="Current uninstall password" Style="{StaticResource Label}"/>
            <PasswordBox app:PasswordBoxHelper.BoundPassword="{Binding CurrentUninstallPassword, Mode=TwoWay}"/>
            <TextBlock Text="…or your login password" Style="{StaticResource Label}"/>
            <PasswordBox app:PasswordBoxHelper.BoundPassword="{Binding AdminLoginPassword, Mode=TwoWay}"/>
            <TextBlock Text="New uninstall password" Style="{StaticResource Label}"/>
            <PasswordBox app:PasswordBoxHelper.BoundPassword="{Binding NewUninstallPassword, Mode=TwoWay}"/>
            <TextBlock Text="Confirm new uninstall password" Style="{StaticResource Label}"/>
            <PasswordBox app:PasswordBoxHelper.BoundPassword="{Binding ConfirmUninstallPassword, Mode=TwoWay}"/>
            <Button Content="Change uninstall password" Command="{Binding ChangeUninstallPasswordCommand}" HorizontalAlignment="Left"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
