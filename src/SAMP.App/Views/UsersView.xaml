<UserControl x:Class="SAMP.App.Views.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:SAMP.App">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Style="{StaticResource Heading}" Text="Users"/>
        <DataGrid Grid.Row="1" ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}" AutoGenerateColumns="False"
                  IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="*"/>
                <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="*"/>
                <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="90"/>
                <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="60"/>
                <DataGridTextColumn Header="Last sign-in (UTC)" Binding="{Binding LastLoginUtc, StringFormat=yyyy-MM-dd HH:mm}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding ErrorMessage}"/>
            <TextBlock Style="{StaticResource InfoText}" Text="{Binding InfoMessage}"/>
            <WrapPanel>
                <StackPanel Margin="0,0,12,0" Width="130"><TextBlock Text="Username" Style="{StaticResource Label}"/><TextBox Text="{Binding NewUsername, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                <StackPanel Margin="0,0,12,0" Width="140"><TextBlock Text="Display name" Style="{StaticResource Label}"/><TextBox Text="{Binding NewDisplayName, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                <StackPanel Margin="0,0,12,0" Width="150"><TextBlock Text="Temporary password" Style="{StaticResource Label}"/><PasswordBox app:PasswordBoxHelper.BoundPassword="{Binding NewPassword, Mode=TwoWay}"/></StackPanel>
                <StackPanel Margin="0,0,12,0" Width="100"><TextBlock Text="Role" Style="{StaticResource Label}"/><ComboBox ItemsSource="{x:Static Member=vm:UsersViewModel.Roles}" SelectedItem="{Binding NewRole}" xmlns:vm="clr-namespace:SAMP.App.Core;assembly=SAMP.App.Core"/></StackPanel>
                <Button Content="Add user" Command="{Binding CreateCommand}" VerticalAlignment="Bottom" Margin="0,0,8,8"/>
            </WrapPanel>
            <WrapPanel>
                <Button Content="Enable / disable selected" Command="{Binding ToggleActiveCommand}"/>
                <Button Content="Make Admin" Command="{Binding SetRoleCommand}" CommandParameter="Admin"/>
                <Button Content="Make Operator" Command="{Binding SetRoleCommand}" CommandParameter="Operator"/>
                <Button Content="Make Viewer" Command="{Binding SetRoleCommand}" CommandParameter="Viewer"/>
            </WrapPanel>
            <StackPanel Orientation="Horizontal">
                <PasswordBox Width="200" app:PasswordBoxHelper.BoundPassword="{Binding ResetPassword, Mode=TwoWay}" Margin="0,4,8,4"/>
                <Button Content="Reset password of selected"  Command="{Binding ResetPasswordCommand}"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
