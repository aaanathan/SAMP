<UserControl x:Class="SAMP.App.Views.ServiceUnavailableView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:SAMP.App">
    <StackPanel Width="420" VerticalAlignment="Center">
        <TextBlock Style="{StaticResource Heading}" Text="SAMP service unavailable"/>
        <TextBlock TextWrapping="Wrap" Text="{Binding Message}" Margin="0,0,0,8"/>
        <TextBlock TextWrapping="Wrap" Style="{StaticResource Label}"
                   Text="USB protection keeps running in the background service. This window retries automatically every 10 seconds."/>
        <Button Content="Retry now" Command="{Binding RetryCommand}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
    </StackPanel>
</UserControl>
