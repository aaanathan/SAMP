<UserControl x:Class="SAMP.App.Views.DeviceLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:SAMP.App">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Style="{StaticResource Heading}" Text="Device connection log"/>
        <WrapPanel Grid.Row="1" Margin="0,0,0,8">
            <StackPanel Margin="0,0,12,0"><TextBlock Text="From" Style="{StaticResource Label}"/><DatePicker SelectedDate="{Binding From}"/></StackPanel>
            <StackPanel Margin="0,0,12,0"><TextBlock Text="To" Style="{StaticResource Label}"/><DatePicker SelectedDate="{Binding To}"/></StackPanel>
            <StackPanel Margin="0,0,12,0" Width="200"><TextBlock Text="Filter" Style="{StaticResource Label}"/><TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
            <Button Content="Load" Command="{Binding LoadCommand}" VerticalAlignment="Bottom" Margin="0,0,8,8"/>
            <Button Content="Verify integrity" Command="{Binding VerifyCommand}" VerticalAlignment="Bottom" Margin="0,0,8,8"/>
            <Button Content="Create rule from selected" Command="{Binding CreateRuleFromSelectedCommand}" VerticalAlignment="Bottom" Margin="0,0,8,8"/>
        </WrapPanel>
        <DataGrid Grid.Row="2" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" AutoGenerateColumns="False"
                  IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding Seq}" Width="60"/>
                <DataGridTextColumn Header="Time (UTC)" Binding="{Binding TimestampUtc, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="150"/>
                <DataGridTextColumn Header="Event" Binding="{Binding EventType}" Width="140"/>
                <DataGridTextColumn Header="Details" Binding="{Binding Payload}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="3" Margin="0,8,0,0">
            <TextBlock TextWrapping="Wrap" Text="{Binding VerifyText}" FontWeight="SemiBold"/>
            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding ErrorMessage}"/>
        </StackPanel>
    </Grid>
</UserControl>
