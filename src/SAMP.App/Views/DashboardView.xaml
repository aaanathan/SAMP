<UserControl x:Class="SAMP.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:SAMP.App">
    <StackPanel MaxWidth="560" HorizontalAlignment="Left">
        <Border Background="#FEE2E2" Padding="12" Margin="0,0,0,12" CornerRadius="6"
                Visibility="{Binding IntegrityAlert, Converter={x:Static app:BoolToVisibility.Instance}}">
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Danger}" FontWeight="SemiBold"
                       Text="Log integrity warning: the device or audit log failed verification. Ask an administrator to review the Audit Log page."/>
        </Border>
        <TextBlock Style="{StaticResource Heading}" Text="USB access"/>
        <Border Padding="20" CornerRadius="8" BorderThickness="1" BorderBrush="#D1D5DB">
            <StackPanel>
                <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding StatusText}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBlocked}" Value="False"><Setter Property="Foreground" Value="{StaticResource Ok}"/></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock FontSize="28" FontFamily="Consolas" Margin="0,8,0,0" Text="{Binding CountdownText}"/>
            </StackPanel>
        </Border>

        <StackPanel Margin="0,16,0,0" IsEnabled="{Binding CanChangeState}">
            <TextBlock Text="Unblock for (minutes)" Style="{StaticResource Label}"/>
            <TextBox Width="120" HorizontalAlignment="Left" Text="{Binding SelectedMinutes, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Style="{StaticResource Label}" Text="Re-enter your password to unblock"/>
            <PasswordBox Width="260" HorizontalAlignment="Left" app:PasswordBoxHelper.BoundPassword="{Binding ReauthPassword, Mode=TwoWay}"/>
            <StackPanel Orientation="Horizontal">
                <Button Content="Unblock USB storage" Command="{Binding UnblockCommand}"/>
                <Button Content="Block now" Command="{Binding BlockNowCommand}"/>
            </StackPanel>
        </StackPanel>
        <TextBlock Style="{StaticResource ErrorText}" Text="{Binding ErrorMessage}"/>
        <TextBlock Style="{StaticResource InfoText}" Text="{Binding InfoMessage}"/>
        <TextBlock Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,12,0,0"
                   Text="USB storage blocks again automatically when the time runs out, even if you close or sign out of this app."/>
    </StackPanel>
</UserControl>
