<Application x:Class="SAMP.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SAMP.App.Core;assembly=SAMP.App.Core"
             xmlns:v="clr-namespace:SAMP.App.Views"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <SolidColorBrush x:Key="Accent" Color="#2563EB"/>
        <SolidColorBrush x:Key="Danger" Color="#B91C1C"/>
        <SolidColorBrush x:Key="Ok" Color="#15803D"/>
        <SolidColorBrush x:Key="Muted" Color="#6B7280"/>

        <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/></Style>
        <Style TargetType="TextBox"><Setter Property="Padding" Value="6,4"/><Setter Property="Margin" Value="0,4,0,8"/></Style>
        <Style TargetType="PasswordBox"><Setter Property="Padding" Value="6,4"/><Setter Property="Margin" Value="0,4,0,8"/></Style>
        <Style TargetType="ComboBox"><Setter Property="Padding" Value="6,4"/><Setter Property="Margin" Value="0,4,0,8"/></Style>
        <Style TargetType="Button"><Setter Property="Padding" Value="14,6"/><Setter Property="Margin" Value="0,4,8,4"/></Style>
        <Style x:Key="Label" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted}"/></Style>
        <Style x:Key="Heading" TargetType="TextBlock"><Setter Property="FontSize" Value="22"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,12"/></Style>
        <Style x:Key="ErrorText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Danger}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,4"/>
        </Style>
        <Style x:Key="InfoText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Ok}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,4"/>
        </Style>

        <DataTemplate DataType="{x:Type vm:SetupViewModel}"><v:SetupView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:LoginViewModel}"><v:LoginView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:RecoveryViewModel}"><v:RecoveryView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ChangePasswordViewModel}"><v:ChangePasswordView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ServiceUnavailableViewModel}"><v:ServiceUnavailableView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ShellViewModel}"><v:MainView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><v:DashboardView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:UsersViewModel}"><v:UsersView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:RulesViewModel}"><v:RulesView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DeviceLogViewModel}"><v:DeviceLogView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AuditViewModel}"><v:AuditView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><v:SettingsView/></DataTemplate>
    </Application.Resources>
</Application>
